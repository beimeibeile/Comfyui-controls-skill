{
  "_meta": {
    "name": "ltx_i2v",
    "version": "1.0",
    "description": "LTX Video int8 distilled 图生视频工作流",
    "model": "ltx-video-2b-int8-distilled.safetensors",
    "default_params": {
      "steps": 30,
      "cfg": 3.0,
      "width": 768,
      "height": 512,
      "duration": 97
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-video-2b-int8-distilled.safetensors",
      "weight_dtype": "int8"
    }
  },
  "5": {
    "class_type": "LTXVImgToVideo",
    "inputs": {
      "width": 768,
      "height": 512,
      "length": 97,
      "clip_vision": ["10", 0],
      "vae": ["11", 0],
      "image": ["12", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a cat playing with a ball, high quality",
      "clip": ["13", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "bad quality, blurry, distorted",
      "clip": ["13", 0]
    }
  },
  "10": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_lt_x.safetensors"
    }
  },
  "11": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    }
  },
  "13": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "t5"
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["11", 0]
    }
  },
  "15": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {
      "filename_prefix": "ltx_i2v",
      "images": ["14", 0],
      "fps": 16.0
    }
  }
}
