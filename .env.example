# ComfyUI 连接配置
COMFYUI_ADDRESS=127.0.0.1:8188
COMFYUI_API_KEY=

# 生成配置
DEFAULT_OUTPUT_DIR=./output
MAX_QUEUE_SIZE=10
QUALITY_CHECK_ENABLED=true

# 模型管理
AUTO_UPDATE_MODELS=false
MODEL_CACHE_SIZE=5

# 自我进化
SELF_LEARNING_ENABLED=true
LEARNING_RATE=0.1

# 算力监控
GPU_MONITOR_INTERVAL=5
MAX_GPU_MEMORY_PERCENT=90
